# SAGE Backend Configuration
APP_NAME=SAGE
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Hermes Agent / OpenShell
HERMES_AGENT_URL=http://localhost:8080
OPENSHELL_ENABLED=true

# NemoClaw
NEMOCLAW_ENABLED=true
NEMOCLAW_PROXY_URL=http://localhost:9090

# Nebius / Nemotron
NEBIUS_API_BASE_URL=https://api.nebius.com/v1
NEBIUS_API_KEY=
NEMOTRON_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct  # placeholder, will use Nemotron-4-340b
