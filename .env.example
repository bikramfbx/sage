# SAGE backend environment — copy to .env and fill in real values.
# .env is gitignored; never commit real keys.

# Nebius bridge (required for chat + vision)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b
VISION_MODEL_ID=openbmb/MiniCPM-V-4_5

# Judge/demo access
# Token judges must pass as X-Judge-Token (also ?demo_token= on the frontend)
JUDGE_DEMO_TOKEN=JUDGE_DEMO_2026
# Total LLM/VLM requests allowed per judge session
JUDGE_SESSION_CAP=50
